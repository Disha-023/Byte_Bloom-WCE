# ==============================================================================
# Agent Service Environment Configuration Template (Commit 3)
# ==============================================================================

# PostgreSQL Connection String (using modern psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/civic_agent

# Service Networking
HOST=0.0.0.0
PORT=8001
ENVIRONMENT=development

# SLA Monitoring Parameters
# Percentage of SLA duration below which the monitoring status changes to WARNING
SLA_WARNING_THRESHOLD_PERCENT=20.0

# Notification Provider Selection: 'none', 'email', or 'twilio'
# Default is 'none' for local development and testing
NOTIFICATION_PROVIDER=none

# Email / SMTP Provider Configuration (Used when NOTIFICATION_PROVIDER=email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=alerts@civic.local

# Twilio Provider Configuration (Used when NOTIFICATION_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

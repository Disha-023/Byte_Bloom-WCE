# ==============================================================================
# Agent Service Environment Configuration Template (Commit 1)
# ==============================================================================

# PostgreSQL Connection String (using modern psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/civic_agent

# Service Networking
HOST=0.0.0.0
PORT=8001
ENVIRONMENT=development

# SLA Monitoring Parameters
# Percentage of SLA duration below which the monitoring status changes to WARNING
SLA_WARNING_THRESHOLD_PERCENT=20.0

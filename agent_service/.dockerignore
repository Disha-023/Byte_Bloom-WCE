# Docker ignore rules for Agent Service
.venv/
venv/
ENV/

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Environment and secrets (CRITICAL: Never bake secrets into Docker images)
.env
.env.local
.env.*.local
.env.*

# Git repository
.git/
.gitignore

# Tests and temporary files
tests/
*.db
*.sqlite
*.sqlite3
*.log
